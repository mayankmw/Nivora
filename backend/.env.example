# Copy this file to .env and adjust the values. Never commit .env.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Comma-separated list of browser origins allowed to call the API.
# Each entry is scheme://host[:port] with no path, for example https://app.nivora.in
CORS_ORIGINS=http://localhost:5173

# Most verbose level to print: error | warn | log | debug | verbose
LOG_LEVEL=debug
